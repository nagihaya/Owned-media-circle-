<%# Aboutページ下部：数字で見るT-Biz／3つの活動／1年の流れ／最新の記事／メンバーの声（空のものは出さない） %>
<% /* ===== 2. 数字で見るT-Biz（編集画面「ホーム：数字で見るT-Biz」。空欄なら非表示） ===== */
const hStats = String(settings.homeStats || '').split(/\r?\n/).map((l) => l.split(/[|｜]/).map((x) => x.trim())).filter((c) => c[0] && c[2]).map((c) => ({ num: c[0], unit: c[1] || '', label: c[2] })).slice(0, 8); %>
<% if(hStats.length){ %><section class="section hs hs-stats" aria-labelledby="hs-stats-t"><div class="hs-head"><h2 id="hs-stats-t" class="section-title section-title-en"><span class="en" lang="en">Numbers</span><span class="ja">数字で見るT-Biz</span></h2></div><ul class="hs-stats-list"><% for(const st of hStats){ %><li><span class="hs-num"><%= st.num %><% if(st.unit){ %><span class="hs-unit"><%= st.unit %></span><% } %></span><span class="hs-label"><%= st.label %></span></li><% } %></ul></section><% } %>
<% /* ===== 3. 3つの活動 ===== */ const activityHref='/articles?type='+encodeURIComponent('活動記録');
const hActs = [
  ['01', '企業インタビュー', '経営者や社員の方に直接お話を聞き、仕事や会社のリアルを記事にしています。', '/interviews', 'インタビューを読む', 'circle'],
  ['02', 'ビジネス知識の発信', '学生のうちに知っておきたいビジネスの知識を、わかりやすくまとめて発信しています。', '/knowledge', '記事を読む', 'square'],
  ['03', 'イベント・出店', '学園祭への出店やイベントなど、教室の外でも「やってみたい」を形にしています。', activityHref, '活動記録を見る', 'triangle'],
]; %>
<section class="section hs hs-acts" id="activities" aria-labelledby="hs-acts-t"><div class="hs-head"><h2 id="hs-acts-t" class="section-title section-title-en"><span class="en" lang="en">What we do</span><span class="ja">3つの活動</span></h2></div><ul class="hs-acts-list"><% for(const [no,title,text,href,more,shape] of hActs){ %><li class="hs-act"><span class="hs-act-icon is-<%= shape %>" aria-hidden="true"></span><span class="hs-act-no" lang="en"><%= no %></span><h3><%= title %></h3><p><%= text %></p><a class="ab" href="<%= href %>"><%= more %><%- include('arrow') %></a></li><% } %></ul></section>
<% /* ===== 4. 1年の流れ（編集画面「ホーム：1年の流れ」。空欄なら非表示） ===== */
const hYear = String(settings.homeTimeline || '').split(/\r?\n/).map((l) => l.split(/[|｜]/).map((x) => x.trim())).filter((c) => c[0] && c[1]).map((c) => ({ when: c[0], what: c[1], note: c[2] || '' })).slice(0, 12); %>
<% if(hYear.length){ %><section class="section hs hs-year" aria-labelledby="hs-year-t"><div class="hs-head"><h2 id="hs-year-t" class="section-title section-title-en"><span class="en" lang="en">Our year</span><span class="ja">1年の流れ</span></h2></div><ol class="hs-year-list" style="--n:<%= hYear.length %>"><% for(const y of hYear){ %><li><span class="hs-year-when"><%= y.when %></span><span class="hs-year-dot" aria-hidden="true"></span><span class="hs-year-what"><%= y.what %></span><% if(y.note){ %><span class="hs-year-note"><%= y.note %></span><% } %></li><% } %></ol></section><% } %>
<% /* ===== 5. 最新の記事（インタビュー・ビジネス知識・活動記録をまとめて新しい順。記事がないカテゴリは出さない） ===== */
const hSeen = new Set(); const hLatest = [...(data.interviews || []), ...(data.knowledge || []), ...(data.activity || [])].filter((a) => !hSeen.has(a.id) && hSeen.add(a.id)).sort((a, b) => String(b.publishedAt).localeCompare(String(a.publishedAt))).slice(0, 6);
const hCats = [['インタビュー', '/interviews', (data.interviews || []).length], ['ビジネス知識', '/knowledge', (data.knowledge || []).length], ['活動記録', activityHref, (data.activity || []).length]].filter((c) => c[2]); %>
<% if(hLatest.length){ %><section class="section hs hs-latest" aria-labelledby="hs-latest-t"><div class="hs-head"><h2 id="hs-latest-t" class="section-title section-title-en"><span class="en" lang="en">Latest</span><span class="ja">最新の記事</span></h2></div><div class="article-grid"><%- include('cards',{items:hLatest}) %></div><nav class="hs-cats" aria-label="カテゴリごとの記事一覧"><% for(const [label,href] of hCats){ %><a class="ab" href="<%= href %>"><%= label %><%- include('arrow') %></a><% } %></nav></section><% } %>
<% /* ===== 6. メンバーの声（新歓メンバー紹介の「入った理由」から先頭3人） ===== */
const hVoices = (settings.shinkanMembers || []).filter((m) => m.bubble).slice(0, 3); %>
<% if(hVoices.length){ %><section class="section hs hs-voices" aria-labelledby="hs-voices-t"><div class="hs-head"><h2 id="hs-voices-t" class="section-title section-title-en"><span class="en" lang="en">Voices</span><span class="ja">メンバーの声</span></h2></div><ul class="hs-voices-list"><% hVoices.forEach((m, i) => { %><li class="hs-voice hs-voice-<%= i %>"><% if(m.url){ %><img src="<%= m.url %>" alt="" width="96" height="96" loading="lazy"><% } else { %><span class="hs-voice-noimg" aria-hidden="true"></span><% } %><p class="hs-voice-text"><%= m.bubble %></p><% if(m.tags && m.tags.length){ %><p class="hs-voice-tags"><%= m.tags.slice(0, 2).map((t) => '#' + t).join(' ') %></p><% } %></li><% }) %></ul><div class="hs-voices-more"><a class="ab" href="/shinkan" target="_blank" rel="noopener">新歓ページでもっと見る<%- include('arrow') %><span class="sr-only">（新しいタブで開く）</span></a></div></section><% } %>
