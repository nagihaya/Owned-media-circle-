<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="csrf-token" content="<%= csrf %>"><title>編集画面 | T-Biz</title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/production.css"><script src="/app.js" defer></script><script src="/admin.js" defer></script></head><body><div class="topline"></div><main class="admin-layout"><header class="admin-nav"><a class="text-link" href="/" target="_blank" rel="noopener">公開ページ</a><span><%= user.name %> / <%= user.role==='admin'?'管理者':'編集者' %></span><button class="btn small" id="logout">ログアウト</button></header><h1>編集画面</h1><nav class="admin-tabs"><a href="#articlesAdmin">記事</a><a href="#siteAdmin">サイト設定</a><a href="#formsAdmin">Googleフォーム</a><a href="#slidesAdmin">スライド</a><a href="#metricsAdmin">計測</a><% if(user.role==='admin'){ %><a href="#operationsAdmin">運用設定</a><a href="#usersAdmin">編集者</a><% } %></nav><p id="globalStatus" class="admin-status" role="status"></p>
<section class="panel" id="articlesAdmin"><h2>記事管理</h2><div class="admin-actions"><input id="adminQuery" type="search" placeholder="タイトル・冒頭文を検索"><label class="check-label"><input id="unclassified" type="checkbox">未分類のみ</label><button class="btn small" id="reloadArticles">絞り込む</button><button class="btn small alt" id="newArticle">記事を登録</button><button class="btn small alt" id="syncRss">RSSを取得</button><button class="btn small alt" id="enrichArticles">AI・画像処理</button></div><div class="table-wrap"><table class="admin-table"><thead><tr><th>記事・投稿日</th><th>タグ</th><th>公開状態</th><th>操作</th></tr></thead><tbody id="adminArticles"></tbody></table></div><div id="adminPagination" class="pagination"></div><details><summary>過去記事のURL・CSVから取り込む</summary><p>noteの記事URLを1行ずつ入力します。CSVのURL列を貼り付けることもできます。日付や見出しを取得できない記事は、記事登録フォームから登録してください。</p><textarea id="importUrls" rows="6" style="width:100%" aria-label="過去記事URL一覧"></textarea><div class="admin-actions"><button class="btn small" id="importNotes">URLから取り込む</button></div><p id="importStatus" class="admin-status" role="status"></p></details></section>
<section class="panel" id="siteAdmin"><h2>サイト設定</h2><form id="settingsForm" class="admin-form-grid"><label>サイト名<input name="siteName" required maxlength="40"></label><label>サブタイトル（空欄で非表示）<input name="subtitle" maxlength="80"></label><label class="wide">運営団体の紹介文<textarea name="org" required maxlength="240"></textarea></label><label>noteマガジンURL（ヘッダー・下部のnoteアイコンにも使用）<input name="noteUrl" type="url" required></label><label>T-Bizリンク<input name="tbizUrl" required placeholder="/about またはHTTPS URL"></label><label>Instagram URL<input name="instagramUrl" type="url" required></label><label>X（旧Twitter）URL（空欄でアイコン非表示）<input name="xUrl" type="url" placeholder="https://x.com/アカウント名"></label><label>返信までの目安<input name="response" required maxlength="40"></label><label>住所・連絡先の案内<input name="contact" maxlength="240"></label><label>ポリシー制定日<input name="policyDate" type="date"></label><button class="btn" type="submit">サイト設定を保存</button><p class="wide admin-status" id="settingsStatus" role="status"></p></form><details><summary>ロゴを変更する</summary><form id="logoForm"><label>ロゴ画像（JPEG/PNG/WebP・8MB以内）<input name="file" type="file" accept="image/jpeg,image/png,image/webp" required></label><button class="btn small" type="submit">ロゴを保存</button></form><p id="logoStatus" role="status"></p></details></section>
<%- include('forms-admin') %>
<section class="panel" id="slidesAdmin"><h2>スライドショー設定</h2><p>最大5枚。写真はサイト側ストレージに保存します。非表示設定で公開から外せます。</p><form id="slidesForm"><div id="slideEditors"></div><div class="admin-actions"><button type="button" class="btn small alt" id="addSlide">写真を追加</button><button class="btn small" type="submit">スライド設定を保存</button></div><p id="slidesStatus" role="status"></p></form></section>
<section class="panel" id="metricsAdmin"><h2>アクセス計測</h2><div class="metric-row"><div class="metric"><span>登録記事</span><b id="metricTotal">0</b></div><div class="metric"><span>公開中</span><b id="metricPublic">0</b></div><div class="metric"><span>未分類</span><b id="metricPending">0</b></div><div class="metric"><span>今月のnote送客</span><b id="metricClicks">0</b></div></div><h3>月別推移</h3><div class="table-wrap"><table class="admin-table"><thead><tr><th>月</th><th>ページ閲覧</th><th>note送客</th></tr></thead><tbody id="monthlyMetrics"></tbody></table></div><h3>ページ別閲覧数</h3><div id="pageMetrics"></div><h3>記事別note送客</h3><div id="clickMetrics"></div><button id="reloadMetrics" class="btn small" type="button">計測を更新</button><p class="date">実際のリクエスト件数です。ユーザー数ではありません。既知のbotは除外します。</p></section>
<% if(user.role==='admin'){ %>
<section class="panel" id="operationsAdmin"><h2>運用設定</h2><p id="operationStatus" class="admin-status"></p><form id="rssForm" class="admin-form-grid"><label class="wide">noteマガジンのRSS URL<input name="rssUrl" type="url" placeholder="https://note.com/.../m/.../rss"></label><button class="btn small" type="submit">RSS URLを保存</button></form><h3>定期ジョブ</h3><p>RSS取得（1日3回）と期限処理（毎日）は、GitHub Actionsから公開サイトの /api/scheduled/run を呼び出して実行します。設定手順はリポジトリの SETUP.md を参照してください。実行結果は上の状態欄に表示されます。</p><h3>Googleフォームの回答管理</h3><p>回答通知と回答コピーはGoogleフォーム側で設定します。フォーム回答・連携シート・通知メールの半年以内の削除は運営側で実施してください。本サイトはGoogleの回答を取得・自動削除しません。サイトに残る旧受付データの期限処理のみ引き続き維持します。</p><div class="admin-actions"><button class="btn small alt" id="runMaintenance" type="button">旧データの期限処理を実行</button></div></section>
<section class="panel" id="usersAdmin"><h2>編集者管理</h2><p>追加する編集者は、同じメールアドレスのGoogleアカウントでログインしてください。パスワードと再設定はGoogleが管理します。</p><form id="inviteForm" class="admin-form-grid"><label>編集者のメールアドレス<input name="email" type="email" required autocomplete="off"></label><button class="btn small" type="submit">編集者を追加</button></form><div id="userList"></div><div id="inviteList"></div></section>
<% } %>
</main>
<dialog id="articleDialog"><h2 id="articleDialogTitle">記事を編集</h2><form id="articleForm" class="admin-form-grid"><label class="wide">タイトル<input name="title" required maxlength="240"></label><label class="wide">冒頭文<textarea name="lead" maxlength="2000"></textarea></label><label class="wide">note記事URL<input name="noteUrl" type="url" required></label><label>投稿日<input name="date" type="datetime-local" required></label><label>業界<select name="industry"><option value="">未分類</option><% for(const x of industries){ %><option><%= x %></option><% } %></select></label><label>企業規模<select name="size"><option value="">未分類</option><% for(const x of sizes){ %><option><%= x %></option><% } %></select></label><label>記事タイプ<select name="type"><option value="">未分類（推定待ち）</option><% for(const x of types){ %><option><%= x %></option><% } %></select></label><label class="wide">見出し画像URL<input name="imageUrl" placeholder="HTTPS画像URL またはアップロード済みパス"></label><label class="wide">見出し画像をアップロード<input name="file" type="file" accept="image/jpeg,image/png,image/webp"></label><label class="check-label"><input name="visible" type="checkbox">公開する</label><label class="check-label"><input name="featured" type="checkbox">注目の記事にする（トップに表示・3件まで）</label><div class="dialog-actions wide"><button class="btn alt" id="cancelArticle" type="button">キャンセル</button><button class="btn" type="submit">記事を保存</button></div><p class="wide admin-status" id="articleStatus" role="status"></p></form></dialog>
</body></html>
