<% if(!items.length){ if(typeof filtered!=='undefined' && filtered){ %><div class="panel empty-state">条件に一致する記事がありません。</div><% } else { %><%- include('card-placeholders') %><% } } %>
<% for(const a of items){ %>
<article class="card post-card"><a class="post-card-link" href="/go/<%= a.id %>" target="_blank" rel="noopener noreferrer"><div class="thumb"><% if(a.imageUrl){ %><img src="<%= a.imageUrl %>" alt="" loading="lazy" width="640" height="360"><% } %></div><div class="card-body"><% const chip=a.type==='インタビュー'?a.industry:a.type==='活動記録'?a.activityKind:null; %><% if(chip){ %><div class="card-chips"><span class="chip chip-industry"><%= chip %></span></div><% } %><h3><%= a.title %></h3><% if(a.lead){ %><p class="card-lead"><%= a.lead %></p><% } %><div class="card-foot"><span class="card-meta"><% if(a.type){ %><span class="card-type"><%= a.type %></span><% } %></span><span class="card-arrow" aria-hidden="true">→</span></div></div><span class="sr-only">（noteで読む・新しいタブで開く）</span></a></article>
<% } %>
