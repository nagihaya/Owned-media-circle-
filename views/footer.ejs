<%
const ext = (u) => /^https:/.test(u || "");
const extAttr = (u) => ext(u) ? 'target="_blank" rel="noopener noreferrer"' : "";
const year = new Date().toLocaleString("ja-JP", { timeZone: "Asia/Tokyo", year: "numeric" }).replace(/\D/g, "");
const columns = [
  { title: "記事を探す", links: [
    ["インタビュー", "/interviews"],
    ["ビジネス知識", "/knowledge"],
    ["イベント", "/interviews?type=" + encodeURIComponent("座談会")],
    ["記事検索", "/articles"],
  ]},
  { title: "メディアについて", links: [
    ["メディアについて", "/about"],
    ["T-Bizについて", settings.tbizUrl],
    ["note", settings.noteUrl],
  ]},
  { title: "取材・協賛", links: [
    ["取材のご依頼", "/contact?form=interview"],
    ["協賛のご相談", "/contact?form=sponsor"],
    ["お問い合わせ", "/contact?form=inquiry"],
  ]},
  { title: "参加する", links: [
    ["メンバー募集", "/recruit"],
    ["Instagram", settings.instagramUrl],
  ]},
  { title: "各種ポリシー", links: policies.map((p, i) => [p.title, "/policy#policy-" + i]) },
];
%>
<div class="site-footer-wrap"><footer class="shell site-footer">
  <div class="site-footer-grid">
    <div class="site-footer-brand">
      <a class="site-footer-logo" href="/"><img src="<%= settings.logoUrl %>" alt="" width="40" height="40" loading="lazy"><span><%= settings.siteName %></span></a>
      <p><%= settings.org %></p>
      <div class="site-footer-social">
        <a href="<%= settings.instagramUrl %>" <%- extAttr(settings.instagramUrl) %> aria-label="Instagram（新しいタブで開く）"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg></a>
        <% if (settings.xUrl) { %><a href="<%= settings.xUrl %>" <%- extAttr(settings.xUrl) %> aria-label="X（新しいタブで開く）"><svg class="x-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a><% } %>
        <a href="<%= settings.noteUrl %>" <%- extAttr(settings.noteUrl) %> aria-label="note（新しいタブで開く）" class="site-footer-note">note</a>
      </div>
    </div>
    <% for (const col of columns) { %>
    <nav class="site-footer-col" aria-label="<%= col.title %>">
      <h2><%= col.title %></h2>
      <ul>
        <% for (const [label, href] of col.links) { %>
        <li><a href="<%= href %>" <%- extAttr(href) %>><%= label %><% if (ext(href)) { %><span class="sr-only">（新しいタブで開く）</span><% } %></a></li>
        <% } %>
      </ul>
    </nav>
    <% } %>
  </div>
  <div class="site-footer-bottom"><p class="site-footer-copy">© <%= year %> <%= settings.siteName %>　運営：T-Biz</p><a class="site-footer-admin" href="/admin">編集ログイン</a></div>
</footer></div>
