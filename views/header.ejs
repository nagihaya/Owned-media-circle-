<!doctype html>
<html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %></title><meta name="description" content="T-Bizが運営する企業インタビューとビジネス知識のメディア。経営者・社員の話を大学生に届けます。"><meta name="keywords" content="T-Biz,企業インタビュー,大学生,ビジネス知識"><meta name="csrf-token" content="<%= csrf %>"><meta property="og:title" content="<%= title %>"><meta property="og:description" content="企業インタビューとビジネス知識"><meta property="og:site_name" content="<%= settings.siteName %>"><meta property="og:type" content="website"><meta name="twitter:card" content="summary">
<% if(canonical){ %><link rel="canonical" href="<%= canonical %>"><meta property="og:url" content="<%= canonical %>"><% } %>
<link rel="icon" href="<%= settings.logoUrl %>"><script>document.documentElement.classList.add("js")</script><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@500&display=swap&text=<%= encodeURIComponent(settings.siteName) %>"><% if(settings.subtitle){ %><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@700&display=swap&text=<%= encodeURIComponent(settings.subtitle) %>"><% } %><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/production.css"><script src="/app.js" defer></script></head><body><a class="skip-link" href="#main">本文へ移動</a><div class="topline"></div>
<header class="shell nav"><div class="brand-row"><a class="brand" href="/"><span class="brand-title"><img class="brand-logo" src="<%= settings.logoUrl %>" alt="T-Bizロゴ" width="48" height="48"><span class="brand-name"><%= settings.siteName %></span></span><% if(settings.subtitle){ %><span class="brand-tagline"><%= settings.subtitle %></span><% } %></a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mainNav" aria-label="メニューを開く"><span></span><span></span><span></span></button></div>
<nav class="navlinks" id="mainNav" aria-label="主要メニュー"><% for(const [url,label] of [['/','ホーム'],['/interviews','インタビュー'],['/knowledge','ビジネス知識'],['/about','メディアについて'],['/contact','取材・協賛']]){ %><a href="<%= url %>" <%- route===url?'aria-current="page"':'' %>><%= label %></a><% } %><a href="<%= settings.tbizUrl %>">T-Biz</a><a class="instagram-link" href="<%= settings.instagramUrl %>" target="_blank" rel="noopener noreferrer" aria-label="Instagram（新しいタブで開く）"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg><span class="menu-label">Instagram</span></a><% if(settings.xUrl){ %><a class="sns-link" href="<%= settings.xUrl %>" target="_blank" rel="noopener noreferrer" aria-label="X（新しいタブで開く）"><svg class="x-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg><span class="menu-label">X</span></a><% } %><% if(settings.noteUrl){ %><a class="sns-link note-link" href="<%= settings.noteUrl %>" target="_blank" rel="noopener noreferrer" aria-label="note（新しいタブで開く）"><span class="note-mark" aria-hidden="true">note</span></a><% } %></nav></header>
