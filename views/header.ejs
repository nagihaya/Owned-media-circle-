<!doctype html>
<html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %></title><meta name="description" content="T-Bizが運営する企業インタビューとビジネス知識のメディア。経営者・社員の話を大学生に届けます。"><meta name="keywords" content="T-Biz,企業インタビュー,大学生,ビジネス知識"><meta name="csrf-token" content="<%= csrf %>"><meta property="og:title" content="<%= title %>"><meta property="og:description" content="企業インタビューとビジネス知識"><meta property="og:site_name" content="<%= settings.siteName %>"><meta property="og:type" content="website"><meta name="twitter:card" content="summary">
<% if(canonical){ %><link rel="canonical" href="<%= canonical %>"><meta property="og:url" content="<%= canonical %>"><% } %>
<link rel="icon" href="<%= settings.logoUrl %>"><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/production.css"><script src="/app.js" defer></script></head><body><a class="skip-link" href="#main">本文へ移動</a><div class="topline"></div>
<header class="shell nav"><div class="brand-row"><a class="brand" href="/"><img class="brand-logo" src="<%= settings.logoUrl %>" alt="T-Bizロゴ" width="48" height="48"><span><%= settings.siteName %></span></a><nav class="utility-links" aria-label="補助メニュー"><a class="publish-link" href="/contact">掲載について</a><a class="login-link" href="/admin">編集ログイン</a></nav></div>
<nav class="navlinks" aria-label="主要メニュー"><% for(const [url,label] of [['/','ホーム'],['/interviews','インタビュー'],['/knowledge','ビジネス知識'],['/about','メディアについて'],['/contact','取材・協賛']]){ %><a href="<%= url %>" <%- route===url?'aria-current="page"':'' %>><%= label %></a><% } %><a href="<%= settings.tbizUrl %>">T-Biz</a><a class="instagram-link" href="<%= settings.instagramUrl %>" target="_blank" rel="noopener noreferrer" aria-label="Instagram（新しいタブで開く）"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg></a></nav></header>
