<%- include('header') %>
<main class="shell" id="main"><section class="page active<%= route==='/'?' page-home':'' %>">
<% if(route==='/'){ %>
<h1 class="sr-only"><%= settings.siteName %> — 企業インタビューとビジネス知識</h1>
<% /* ===== トップのヒーロー：写真を画面いっぱいに敷き、中央に大きな英語の見出し＋日本語のひとこと。右下に新歓への丸いボタン =====
   写真：編集画面「紹介ブロックの写真」。英語の見出し：「ヒーローの英語の見出し」（空欄なら既定の一文）。日本語：キャッチコピー（* は外す） */
/* 写真は複数枚を順に切り替える：紹介ブロックの写真 → ギャラリーの写真（最大6枚） */
const heroImgs = [...new Set([settings.introImageUrl, ...((settings.gallery || []).map((g) => g.url))].filter(Boolean))].slice(0, 6);
const heroImg = heroImgs[0] || '';
const heroEn = String(settings.heroEn || '').trim() || 'Turn Ideas into Action';
const heroJa = String(settings.introCatch || '').replace(/[*＊]/g, '').split(/\r?\n/).map((l) => l.trim()).filter(Boolean).join(''); %>
<section class="hx<%= heroImg ? ' has-photo' : '' %>" aria-label="このメディアについて"><% heroImgs.forEach((src, i) => { %><img class="hx-photo<%= i === 0 ? ' is-on' : '' %>" src="<%= src %>" alt="<%= i === 0 ? (settings.introImageAlt || 'T-Bizのメンバーが活動している様子') : '' %>" width="1920" height="1080" <%- i === 0 ? 'loading="eager" fetchpriority="high"' : 'loading="lazy" decoding="async"' %>><% }) %><div class="hx-shade" aria-hidden="true"></div>
<div class="hx-copy"><p class="hx-en" lang="en"><%= heroEn %></p><% if(heroJa){ %><p class="hx-ja"><%= heroJa %></p><% } %><a class="ab hx-more" href="/about">T-Bizとは？<%- include('arrow') %></a></div>
<a class="hx-badge" href="/shinkan" target="_blank" rel="noopener"><span class="hx-badge-view" aria-hidden="true"><span class="hx-badge-track"><span class="hx-badge-set"><span>WELCOME!</span><span class="hx-badge-dot">●</span><span>新歓・入会受付中！</span><span class="hx-badge-dot">●</span><span>WELCOME!</span><span class="hx-badge-dot">●</span><span>新歓・入会受付中！</span><span class="hx-badge-dot">●</span></span><span class="hx-badge-set"><span>WELCOME!</span><span class="hx-badge-dot">●</span><span>新歓・入会受付中！</span><span class="hx-badge-dot">●</span><span>WELCOME!</span><span class="hx-badge-dot">●</span><span>新歓・入会受付中！</span><span class="hx-badge-dot">●</span></span></span></span><span class="hx-badge-go" aria-hidden="true"><svg viewBox="0 0 20 20" focusable="false"><path d="M5 15 15 5M7 5h8v8" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square"/></svg></span><span class="sr-only">新歓・入会受付中（新歓特設ページを新しいタブで開く）</span></a></section><% /* ===== ヒーローの下：以前のヒーローのような紹介文（左：小さな一文＋キャッチコピー、右：説明文＋ボタン） ===== */
const tiMarkRe = /[*＊]([^*＊\n]+)[*＊]/g;
const tiLines = String(settings.introCatch || '').split(/\r?\n/).filter((l) => l.trim());
const tiHasMark = /[*＊][^*＊\n]+[*＊]/.test(settings.introCatch || ''); %>
<% if(tiLines.length || settings.introText){ %><section class="intro-band th ti" aria-label="T-Bizについて"><div class="th-inner"><div class="ti-left"><% if(settings.introLabel){ %><p class="intro-label"><%= settings.introLabel %></p><% } %><% if(tiLines.length){ %><p class="th-catch"><% tiLines.forEach((line, li) => { %><span class="th-line"><% if(tiHasMark){ line.split(tiMarkRe).forEach((part, pi) => { %><% if(pi % 2){ %><span class="intro-mark"><%= part %></span><% } else { %><%= part %><% } %><% }) } else if(tiLines.length > 1 && li === tiLines.length - 1){ %><span class="intro-mark"><%= line %></span><% } else { %><%= line %><% } %></span><% }) %></p><% } %></div>
<div class="ti-right"><% if(settings.introText){ %><p class="th-body"><%= String(settings.introText).replace(/[*＊]/g, '') %></p><% } %><a class="ab" href="/about">T-Bizとは？<%- include('arrow') %></a></div></div></section><% } %><% const gallery=settings.gallery||[]; if(gallery.length){ %><section class="gallery-band" aria-label="活動の様子"><div class="gallery-viewport" tabindex="0" aria-label="活動写真（横にスクロールできます）"><div class="gallery-track" style="--n:<%= gallery.length %>"><% for(const copy of [0,1]){ for(const g of gallery){ %><figure class="gallery-item" <%- copy?'aria-hidden="true" data-copy':'' %>><img src="<%= g.url %>" alt="<%= copy?'':g.alt %>" loading="lazy"></figure><% } } %></div></div></section><% } %>

<section class="section section-split"><div class="section-head"><h2 class="section-title section-title-en"><span class="en" lang="en">Interview</span><span class="ja">インタビュー</span></h2><a class="ab more-link-pc" href="/interviews" lang="en" aria-label="インタビューの記事をもっと見る">see more<%- include('arrow') %></a></div><div class="cards"><%- include('cards',{items:data.interviews}) %></div><a class="ab more-link-sp" href="/interviews" lang="en" aria-label="インタビューの記事をもっと見る">see more<%- include('arrow') %></a></section>
<% const activityHref='/articles?type='+encodeURIComponent('活動記録'); %><section class="section section-split"><div class="section-head"><h2 class="section-title section-title-en"><span class="en" lang="en">Activity</span><span class="ja">活動記録</span></h2><a class="ab more-link-pc" href="<%= activityHref %>" lang="en" aria-label="活動記録の記事をもっと見る">see more<%- include('arrow') %></a></div><div class="cards"><%- include('cards',{items:data.activity}) %></div><a class="ab more-link-sp" href="<%= activityHref %>" lang="en" aria-label="活動記録の記事をもっと見る">see more<%- include('arrow') %></a></section>
<section class="section section-split"><div class="section-head"><h2 class="section-title section-title-en"><span class="en" lang="en">Knowledge</span><span class="ja">ビジネス知識</span></h2><a class="ab more-link-pc" href="/knowledge" lang="en" aria-label="ビジネス知識の記事をもっと見る">see more<%- include('arrow') %></a></div><div class="cards"><%- include('cards',{items:data.knowledge}) %></div><a class="ab more-link-sp" href="/knowledge" lang="en" aria-label="ビジネス知識の記事をもっと見る">see more<%- include('arrow') %></a></section>

<% } else if(['/articles','/interviews','/knowledge'].includes(route)){ %>
<div class="page-intro"><h1><%= heading %></h1></div><%- include('search') %>
<% } else if(route==='/about'){ %>
<% const nl=(t)=>String(t).split('\n'); const MONTHS=['Jan.','Feb.','Mar.','Apr.','May','Jun.','Jul.','Aug.','Sep.','Oct.','Nov.','Dec.']; const history=[]; for(const raw of String(settings.aboutHistory||'').split(/\r?\n/)){ const line=raw.trim(); if(!line) continue; const m=line.match(/^(\d{4})\s*[.\/\-年]?\s*(?:(\d{1,2})\s*月?)?[\s　:：]+(.+)$/); if(!m){ if(history.length) history[history.length-1].items.at(-1).text+='\n'+line; continue; } const year=m[1]; let g=history.find((h)=>h.year===year); if(!g){ g={year,items:[]}; history.push(g); } g.items.push({month:m[2]?MONTHS[Number(m[2])-1]||'':'',text:m[3]}); } %>
<div class="about-page">
<section class="about-hero<%= settings.aboutImageUrl?' has-photo':'' %>"><div class="about-hero-copy"><p class="about-kicker" lang="en">ABOUT</p><h1 class="about-title"><span lang="en">About Us</span><span class="about-title-ja">私たちについて</span></h1><% if(settings.aboutLead){ %><p class="about-lead"><%= settings.aboutLead %></p><% } %></div><% if(settings.aboutImageUrl){ %><div class="about-hero-photo"><img src="<%= settings.aboutImageUrl %>" alt="" fetchpriority="high"></div><% } %></section>
<% if(settings.introCatch){ %><section class="about-statement"><p class="about-statement-text"><% settings.introCatch.split(/\r?\n/).forEach((line,li,all)=>{ %><%= line.replace(/[*＊]/g,'') %><% if(li<all.length-1){ %><br><% } %><% }) %></p><p class="about-purpose"><%= tbizProfile.purpose %></p></section><% } %>
<section class="about-profile"><h2 class="about-profile-title"><span lang="en">Profile</span><span class="about-sub">団体概要</span></h2>
<div class="about-profile-grid">
<div class="about-outline"><h3 class="about-col-title"><span lang="en">Outline</span><span class="about-sub">団体情報</span></h3><dl class="about-dl"><% for(const [k,v] of tbizProfile.facts){ %><div><dt><%= k %></dt><dd><% nl(v).forEach((line,i,all)=>{ %><%= line %><% if(i<all.length-1){ %><br><% } %><% }) %></dd></div><% } %><div><dt>活動内容</dt><dd><ul class="about-activities"><% for(const act of tbizProfile.activities){ %><li><%= act %></li><% } %></ul></dd></div><div><dt>運営メディア</dt><dd><%= settings.siteName %>（本サイト）<br>企業の経営者・社員へのインタビューや、T-Bizの活動の報告を掲載しています。<% if(settings.noteUrl){ %><br><a class="link" href="<%= settings.noteUrl %>" target="_blank" rel="noopener noreferrer">noteを見る →</a><% } %></dd></div></dl></div>
<div class="about-history"><h3 class="about-col-title"><span lang="en">History</span><span class="about-sub">沿革</span></h3><% if(history.length){ %><ol class="about-timeline"><% for(const g of history){ %><li class="about-year"><p class="about-year-num"><%= g.year %></p><dl class="about-events"><% for(const it of g.items){ %><div><dt lang="en"><%= it.month %></dt><dd><% nl(it.text).forEach((line,i,all)=>{ %><%= line %><% if(i<all.length-1){ %><br><% } %><% }) %></dd></div><% } %></dl></li><% } %></ol><% } else { %><p class="about-empty">準備中です。</p><% } %></div>
</div></section>
<%- include('about-sections') %>
</div>
<% } else if(route==='/contact'){ %>
<div class="page-intro"><h1>取材・協賛のご相談</h1></div><div class="contact-google-layout"><div class="panel"><h2>ご相談内容の例</h2><p>・経営者・社員インタビュー<br>・学生向けイベントの協賛<br>・採用広報や仕事紹介<br>・T-Bizとの共同企画</p><p>返信までの目安：<%= settings.response %></p><p><%= settings.contact %></p></div><%- include('google-form') %></div>
<% } else if(route==='/policy'){ %>
<div class="page-intro"><h1>各種ポリシー</h1></div><nav class="policy-index"><% policies.forEach((p,i)=>{ %><a class="text-link" href="#policy-<%= i %>"><%= p.title %></a><% }); %></nav>
<% policies.forEach((p,i)=>{ %><article class="panel policy-doc" id="policy-<%= i %>"><h2><%= p.title %></h2><p><%= p.intro.replaceAll('【メディア名】',settings.siteName) %></p><% for(const section of p.sections){ %><h3><%= section.title %></h3><% if(section.text){ %><p><%= section.text.replaceAll('【メディア名】',settings.siteName) %></p><% } %><% if(section.items){ %><ul><% for(const item of section.items){ %><li><%= item %></li><% } %></ul><% } %><% if(section.after){ %><p><%= section.after %></p><% } %><% if(section.contact){ %><a class="text-link" href="/contact">お問い合わせフォーム</a><% } %><% } %><p class="date">制定日：<%= settings.policyDate||'未確定' %></p></article><% }); %>
<% } else if(route==='/recruit'){ %><div class="page-intro"><h1>メンバー募集</h1></div><div class="panel"><h2>T-Biz</h2><p><%= settings.org %></p><a class="text-link" href="<%= settings.instagramUrl %>" target="_blank" rel="noopener noreferrer">Instagramで活動を見る</a></div><%- include('google-form') %><% } %>
</section></main><%- include('footer') %></body></html>
