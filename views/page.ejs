<%- include('header') %>
<main class="shell" id="main"><section class="page active<%= route==='/'?' page-home':'' %>">
<% if(route==='/'){ %>
<h1 class="sr-only"><%= settings.siteName %> — 企業インタビューとビジネス知識</h1>
<% if(settings.subtitle){ %><p class="hero-subtitle"><%= settings.subtitle %></p><% } %>
<div class="hero"><div class="hero-art hero-slider" role="region" aria-roledescription="カルーセル" aria-label="注目の記事写真"><div class="slider-stage">
<% if(!data.slides.length){ %><div class="slide-placeholder">写真を準備中です。</div><% } %>
<% for(let i=0;i<data.slides.length;i++){ const s=data.slides[i]; const tags=(s.tags||'').split(',').filter(Boolean); const card=Boolean(s.numberLabel||s.dateLabel||s.category||s.author||s.detail||tags.length||s.label); const tag=s.linkUrl?'a':'div'; %><div class="slide <%= card?'is-card':'' %> <%= i===0?'is-active':'' %>" aria-hidden="<%= i!==0 %>"><<%= tag %> class="slide-inner" <% if(s.linkUrl){ %>href="<%= s.linkUrl %>" <%- s.linkUrl.startsWith('https:')?'target="_blank" rel="noopener noreferrer"':'' %><% } %>><% if(card){ %><div class="slide-text"><div class="slide-meta"><div class="slide-no-date"><span class="slide-no"><%= s.numberLabel || String(i+1).padStart(2,'0') %></span><% if(s.dateLabel){ %><span class="slide-date"><%= s.dateLabel %></span><% } %></div><% if(s.category){ %><span class="slide-cat"><%= s.category %></span><% } %></div><% if(s.label){ %><p class="slide-title"><%= s.label %></p><% } %><% if(s.author){ %><p class="slide-person"><%= s.author %></p><% } %><% if(s.detail){ %><p class="slide-detail"><%= s.detail %></p><% } %><% if(tags.length){ %><ul class="slide-tags"><% for(const t of tags){ %><li><%= t %></li><% } %></ul><% } %></div><% } %><div class="slide-img"><img src="<%= s.imageUrl %>" alt="<%= card ? '' : s.label %>" width="1600" height="900" <%- i>0?'loading="lazy"':'' %>><% if(!card && s.label){ %><span><%= s.label %></span><% } %></div></<%= tag %>></div><% } %>
<% if(data.slides.length>1){ %><button class="slider-control prev" type="button" aria-label="前の写真">‹</button><button class="slider-control next" type="button" aria-label="次の写真">›</button><button class="slider-pause" type="button">一時停止</button><% } %></div>
<% if(data.slides.length>1){ %><div class="slider-dots"><% for(let i=0;i<data.slides.length;i++){ %><button class="slider-dot <%= i===0?'is-active':'' %>" type="button" aria-label="写真<%= i+1 %>を表示" aria-pressed="<%= i===0 %>"></button><% } %></div><% } %></div></div>
<section class="section"><div class="section-head"><h2 class="section-title">記事を探す</h2></div><form class="quick-search" action="/articles"><label for="exactKeyword">フリーワード（完全一致）</label><div class="quick-search-row"><input id="exactKeyword" name="q" type="search" maxlength="240" placeholder="記事タイトルを入力"><input type="hidden" name="exact" value="true"><button class="btn" type="submit">検索</button></div></form><div class="tag-cloud"><a class="tag-sp-only" href="/interviews">インタビュー</a><% for(const i of industries){ %><a class="tag-pc-only" href="/articles?industry=<%= encodeURIComponent(i) %>"><%= i %></a><% } %><% for(const i of sizes){ %><a class="tag-pc-only" href="/articles?size=<%= encodeURIComponent(i) %>"><%= i %></a><% } %><a href="/articles?q=<%= encodeURIComponent('インターン') %>">インターン</a><a href="/knowledge">ビジネス知識</a></div></section>
<section class="section"><div class="section-head"><h2 class="section-title">注目の記事</h2></div><% if(data.featured){ const a=data.featured; %><div class="feature"><div class="feature-visual"><% if(a.imageUrl){ %><img src="<%= a.imageUrl %>" alt="" loading="lazy"><% } %></div><div class="feature-copy"><div class="eyebrow"><%= a.type||'' %></div><h3><%= a.title %></h3><div class="feature-meta"><% if(a.industry){ %><span class="pill dark"><%= a.industry %></span><% } %><% if(a.size){ %><span class="pill dark"><%= a.size %></span><% } %><span class="pill dark"><%= formatDate(a.publishedAt) %></span></div><a class="btn feature-link" href="/go/<%= a.id %>" target="_blank" rel="noopener noreferrer">noteで読む →</a></div></div><% }else{ %><div class="panel empty-state">記事を準備中です。</div><% } %></section>
<section class="section"><div class="section-head"><h2 class="section-title">インタビュー</h2><a class="link" href="/interviews">すべて見る →</a></div><div class="cards"><%- include('cards',{items:data.interviews}) %></div></section>
<section class="section"><div class="section-head"><h2 class="section-title">ビジネス知識</h2><a class="link" href="/knowledge">すべて見る →</a></div><div class="cards"><%- include('cards',{items:data.knowledge}) %></div></section>
<section class="section"><div class="cta"><h2>取材・協賛</h2><a class="btn" href="/contact">お問い合わせ →</a></div></section>
<% } else if(['/articles','/interviews','/knowledge'].includes(route)){ %>
<div class="page-intro"><h1><%= heading %></h1></div><%- include('search') %>
<% } else if(route==='/about'){ %>
<div class="page-intro"><h1>メディアについて</h1></div><div class="about-grid"><div class="panel"><h2>目的</h2><p>企業の経営者・社員へのインタビューを掲載し、学生が企業や仕事を知るための情報を提供します。</p></div><div class="panel"><h2>T-Biz</h2><p><%= settings.org %></p><a class="link" href="<%= settings.noteUrl %>" target="_blank" rel="noopener noreferrer">noteを見る →</a></div></div>
<% } else if(route==='/contact'){ %>
<div class="page-intro"><h1>取材・協賛のご相談</h1></div><div class="contact-google-layout"><div class="panel"><h2>ご相談内容の例</h2><p>・経営者・社員インタビュー<br>・学生向けイベントの協賛<br>・採用広報や仕事紹介<br>・T-Bizとの共同企画</p><p>返信までの目安：<%= settings.response %></p><p><%= settings.contact %></p></div><%- include('google-form') %></div>
<% } else if(route==='/policy'){ %>
<div class="page-intro"><h1>各種ポリシー</h1></div><nav class="policy-index"><% policies.forEach((p,i)=>{ %><a class="text-link" href="#policy-<%= i %>"><%= p.title %></a><% }); %></nav>
<% policies.forEach((p,i)=>{ %><article class="panel policy-doc" id="policy-<%= i %>"><h2><%= p.title %></h2><p><%= p.intro.replaceAll('【メディア名】',settings.siteName) %></p><% for(const section of p.sections){ %><h3><%= section.title %></h3><% if(section.text){ %><p><%= section.text.replaceAll('【メディア名】',settings.siteName) %></p><% } %><% if(section.items){ %><ul><% for(const item of section.items){ %><li><%= item %></li><% } %></ul><% } %><% if(section.after){ %><p><%= section.after %></p><% } %><% if(section.contact){ %><a class="text-link" href="/contact">お問い合わせフォーム</a><% } %><% } %><p class="date">制定日：<%= settings.policyDate||'未確定' %></p></article><% }); %>
<% } else if(route==='/recruit'){ %><div class="page-intro"><h1>メンバー募集</h1></div><div class="panel"><h2>T-Biz</h2><p><%= settings.org %></p><a class="text-link" href="<%= settings.instagramUrl %>" target="_blank" rel="noopener noreferrer">Instagramで活動を見る</a></div><%- include('google-form') %><% } %>
</section></main><%- include('footer') %></body></html>
