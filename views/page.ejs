<%- include('header') %>
<main class="shell" id="main"><section class="page active<%= route==='/'?' page-home':'' %>">
<% if(route==='/'){ %>
<h1 class="sr-only"><%= settings.siteName %> — 企業インタビューとビジネス知識</h1>
<% /* ===== トップのヒーロー：左にコピー、右にポラロイド風の写真3枚 =====
   写真はここで1か所にまとめる（1枚目：紹介ブロックの写真、2・3枚目：ギャラリーの先頭2枚）。
   alt は編集画面の「写真の説明」から。差し替えは編集画面で行う。 */
const heroPhotos = [
  { src: settings.introImageUrl, alt: settings.introImageAlt },
  ...((settings.gallery || []).slice(0, 2).map((g) => ({ src: g.url, alt: g.alt }))),
].filter((p) => p.src).slice(0, 3).map((p) => ({ src: p.src, alt: p.alt || 'T-Bizのメンバーが活動している様子' }));
const heroMarkRe = /[*＊]([^*＊\n]+)[*＊]/g;
const heroLines = String(settings.introCatch || '').split(/\r?\n/).filter((l) => l.trim());
const heroHasMark = /[*＊][^*＊\n]+[*＊]/.test(settings.introCatch || ''); %>
<% if(heroLines.length || settings.introText || heroPhotos.length){ %><% /* 街並みイラスト（views/town.ejs）。いったん非表示。出すときは true に */ const showTown = false; %><section class="intro-band th<%= showTown ? ' has-town' : '' %>" aria-label="このメディアについて"><div class="intro-dots" aria-hidden="true"></div><% if(showTown){ %><%- include('town') %><% } %><div class="th-inner<%= heroPhotos.length?' has-photos':'' %>"><a class="th-press" href="/contact">取材のご依頼はこちら<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M5 15 15 5M7 5h8v8" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square"/></svg></a>
<div class="th-copy"><% if(settings.introLabel){ %><p class="intro-label"><%= settings.introLabel %></p><% } %>
<% if(heroLines.length){ %><p class="th-catch"><% heroLines.forEach((line, li) => { %><span class="th-line"><% if(heroHasMark){ line.split(heroMarkRe).forEach((part, pi) => { %><% if(pi % 2){ %><span class="intro-mark"><%= part %></span><% } else { %><%= part %><% } %><% }) } else if(heroLines.length > 1 && li === heroLines.length - 1){ %><span class="intro-mark"><%= line %></span><% } else { %><%= line %><% } %></span><% }) %></p><% } %>
<% if(settings.introText){ %><p class="th-body"><%= String(settings.introText).replace(/[*＊]/g, '') %></p><% } %>
<div class="th-ctas"><a class="ab" href="/about">活動を知る<%- include('arrow') %></a><a class="ab" href="/shinkan" target="_blank" rel="noopener">新歓・入会<%- include('arrow') %><span class="sr-only">（新しいタブで開く）</span></a></div></div>
<% if(heroPhotos.length){ %><div class="th-photos"><% heroPhotos.forEach((p, i) => { %><figure class="th-photo th-photo-<%= i + 1 %>"><img src="<%= p.src %>" alt="<%= p.alt %>" width="520" height="650" loading="eager" <%- i === 0 ? 'fetchpriority="high"' : '' %>></figure><% }) %></div><% } %>
</div></section><% } %><% const gallery=settings.gallery||[]; if(gallery.length){ %><section class="gallery-band" aria-label="活動の様子"><div class="gallery-viewport" tabindex="0" aria-label="活動写真（横にスクロールできます）"><div class="gallery-track" style="--n:<%= gallery.length %>"><% for(const copy of [0,1]){ for(const g of gallery){ %><figure class="gallery-item" <%- copy?'aria-hidden="true" data-copy':'' %>><img src="<%= g.url %>" alt="<%= copy?'':g.alt %>" loading="lazy"></figure><% } } %></div></div></section><% } %>

<% /* ===== 2. 数字で見るT-Biz（編集画面「ホーム：数字で見るT-Biz」。空欄なら非表示） ===== */
const hStats = String(settings.homeStats || '').split(/\r?\n/).map((l) => l.split(/[|｜]/).map((x) => x.trim())).filter((c) => c[0] && c[2]).map((c) => ({ num: c[0], unit: c[1] || '', label: c[2] })).slice(0, 8); %>
<% if(hStats.length){ %><section class="section hs hs-stats" aria-labelledby="hs-stats-t"><div class="hs-head"><h2 id="hs-stats-t" class="section-title section-title-en"><span class="en" lang="en">Numbers</span><span class="ja">数字で見るT-Biz</span></h2></div><ul class="hs-stats-list"><% for(const st of hStats){ %><li><span class="hs-num"><%= st.num %><% if(st.unit){ %><span class="hs-unit"><%= st.unit %></span><% } %></span><span class="hs-label"><%= st.label %></span></li><% } %></ul></section><% } %>
<% /* ===== 3. 3つの活動 ===== */ const activityHref='/articles?type='+encodeURIComponent('活動記録');
const hActs = [
  ['01', '企業インタビュー', '経営者や社員の方に直接お話を聞き、仕事や会社のリアルを記事にしています。', '/interviews', 'インタビューを読む', 'circle'],
  ['02', 'ビジネス知識の発信', '学生のうちに知っておきたいビジネスの知識を、わかりやすくまとめて発信しています。', '/knowledge', '記事を読む', 'square'],
  ['03', 'イベント・出店', '学園祭への出店やイベントなど、教室の外でも「やってみたい」を形にしています。', activityHref, '活動記録を見る', 'triangle'],
]; %>
<section class="section hs hs-acts" id="activities" aria-labelledby="hs-acts-t"><div class="hs-head"><h2 id="hs-acts-t" class="section-title section-title-en"><span class="en" lang="en">What we do</span><span class="ja">3つの活動</span></h2></div><ul class="hs-acts-list"><% for(const [no,title,text,href,more,shape] of hActs){ %><li class="hs-act"><span class="hs-act-icon is-<%= shape %>" aria-hidden="true"></span><span class="hs-act-no" lang="en"><%= no %></span><h3><%= title %></h3><p><%= text %></p><a class="ab" href="<%= href %>"><%= more %><%- include('arrow') %></a></li><% } %></ul></section>
<% /* ===== 4. 1年の流れ（編集画面「ホーム：1年の流れ」。空欄なら非表示） ===== */
const hYear = String(settings.homeTimeline || '').split(/\r?\n/).map((l) => l.split(/[|｜]/).map((x) => x.trim())).filter((c) => c[0] && c[1]).map((c) => ({ when: c[0], what: c[1], note: c[2] || '' })).slice(0, 12); %>
<% if(hYear.length){ %><section class="section hs hs-year" aria-labelledby="hs-year-t"><div class="hs-head"><h2 id="hs-year-t" class="section-title section-title-en"><span class="en" lang="en">Our year</span><span class="ja">1年の流れ</span></h2></div><ol class="hs-year-list" style="--n:<%= hYear.length %>"><% for(const y of hYear){ %><li><span class="hs-year-when"><%= y.when %></span><span class="hs-year-dot" aria-hidden="true"></span><span class="hs-year-what"><%= y.what %></span><% if(y.note){ %><span class="hs-year-note"><%= y.note %></span><% } %></li><% } %></ol></section><% } %>
<% /* ===== 5. 最新の記事（インタビュー・ビジネス知識・活動記録をまとめて新しい順。記事がないカテゴリは出さない） ===== */
const hSeen = new Set(); const hLatest = [...(data.interviews || []), ...(data.knowledge || []), ...(data.activity || [])].filter((a) => !hSeen.has(a.id) && hSeen.add(a.id)).sort((a, b) => String(b.publishedAt).localeCompare(String(a.publishedAt))).slice(0, 6);
const hCats = [['インタビュー', '/interviews', (data.interviews || []).length], ['ビジネス知識', '/knowledge', (data.knowledge || []).length], ['活動記録', activityHref, (data.activity || []).length]].filter((c) => c[2]); %>
<% if(hLatest.length){ %><section class="section hs hs-latest" aria-labelledby="hs-latest-t"><div class="hs-head"><h2 id="hs-latest-t" class="section-title section-title-en"><span class="en" lang="en">Latest</span><span class="ja">最新の記事</span></h2></div><div class="article-grid"><%- include('cards',{items:hLatest}) %></div><nav class="hs-cats" aria-label="カテゴリごとの記事一覧"><% for(const [label,href] of hCats){ %><a class="ab" href="<%= href %>"><%= label %><%- include('arrow') %></a><% } %></nav></section><% } %>
<% /* ===== 6. メンバーの声（新歓メンバー紹介の「入った理由」から先頭3人） ===== */
const hVoices = (settings.shinkanMembers || []).filter((m) => m.bubble).slice(0, 3); %>
<% if(hVoices.length){ %><section class="section hs hs-voices" aria-labelledby="hs-voices-t"><div class="hs-head"><h2 id="hs-voices-t" class="section-title section-title-en"><span class="en" lang="en">Voices</span><span class="ja">メンバーの声</span></h2></div><ul class="hs-voices-list"><% hVoices.forEach((m, i) => { %><li class="hs-voice hs-voice-<%= i %>"><% if(m.url){ %><img src="<%= m.url %>" alt="" width="96" height="96" loading="lazy"><% } else { %><span class="hs-voice-noimg" aria-hidden="true"></span><% } %><p class="hs-voice-text"><%= m.bubble %></p><% if(m.tags && m.tags.length){ %><p class="hs-voice-tags"><%= m.tags.slice(0, 2).map((t) => '#' + t).join(' ') %></p><% } %></li><% }) %></ul><div class="hs-voices-more"><a class="ab" href="/shinkan" target="_blank" rel="noopener">新歓ページでもっと見る<%- include('arrow') %><span class="sr-only">（新しいタブで開く）</span></a></div></section><% } %>

<% } else if(['/articles','/interviews','/knowledge'].includes(route)){ %>
<div class="page-intro"><h1><%= heading %></h1></div><%- include('search') %>
<% } else if(route==='/about'){ %>
<% const nl=(t)=>String(t).split('\n'); const MONTHS=['Jan.','Feb.','Mar.','Apr.','May','Jun.','Jul.','Aug.','Sep.','Oct.','Nov.','Dec.']; const history=[]; for(const raw of String(settings.aboutHistory||'').split(/\r?\n/)){ const line=raw.trim(); if(!line) continue; const m=line.match(/^(\d{4})\s*[.\/\-年]?\s*(?:(\d{1,2})\s*月?)?[\s　:：]+(.+)$/); if(!m){ if(history.length) history[history.length-1].items.at(-1).text+='\n'+line; continue; } const year=m[1]; let g=history.find((h)=>h.year===year); if(!g){ g={year,items:[]}; history.push(g); } g.items.push({month:m[2]?MONTHS[Number(m[2])-1]||'':'',text:m[3]}); } %>
<div class="about-page">
<section class="about-hero<%= settings.aboutImageUrl?' has-photo':'' %>"><div class="about-hero-copy"><p class="about-kicker" lang="en">ABOUT</p><h1 class="about-title"><span lang="en">About Us</span><span class="about-title-ja">私たちについて</span></h1><% if(settings.aboutLead){ %><p class="about-lead"><%= settings.aboutLead %></p><% } %></div><% if(settings.aboutImageUrl){ %><div class="about-hero-photo"><img src="<%= settings.aboutImageUrl %>" alt="" fetchpriority="high"></div><% } %></section>
<% if(settings.introCatch){ %><section class="about-statement"><p class="about-statement-text"><% settings.introCatch.split(/\r?\n/).forEach((line,li,all)=>{ %><%= line.replace(/[*＊]/g,'') %><% if(li<all.length-1){ %><br><% } %><% }) %></p><p class="about-purpose"><%= tbizProfile.purpose %></p></section><% } %>
<section class="about-profile"><h2 class="about-profile-title"><span lang="en">Profile</span><span class="about-sub">団体概要</span></h2>
<div class="about-profile-grid">
<div class="about-outline"><h3 class="about-col-title"><span lang="en">Outline</span><span class="about-sub">団体情報</span></h3><dl class="about-dl"><% for(const [k,v] of tbizProfile.facts){ %><div><dt><%= k %></dt><dd><% nl(v).forEach((line,i,all)=>{ %><%= line %><% if(i<all.length-1){ %><br><% } %><% }) %></dd></div><% } %><div><dt>活動内容</dt><dd><ul class="about-activities"><% for(const act of tbizProfile.activities){ %><li><%= act %></li><% } %></ul></dd></div><div><dt>運営メディア</dt><dd><%= settings.siteName %>（本サイト）<br>企業の経営者・社員へのインタビューや、T-Bizの活動の報告を掲載しています。<% if(settings.noteUrl){ %><br><a class="link" href="<%= settings.noteUrl %>" target="_blank" rel="noopener noreferrer">noteを見る →</a><% } %></dd></div></dl></div>
<div class="about-history"><h3 class="about-col-title"><span lang="en">History</span><span class="about-sub">沿革</span></h3><% if(history.length){ %><ol class="about-timeline"><% for(const g of history){ %><li class="about-year"><p class="about-year-num"><%= g.year %></p><dl class="about-events"><% for(const it of g.items){ %><div><dt lang="en"><%= it.month %></dt><dd><% nl(it.text).forEach((line,i,all)=>{ %><%= line %><% if(i<all.length-1){ %><br><% } %><% }) %></dd></div><% } %></dl></li><% } %></ol><% } else { %><p class="about-empty">準備中です。</p><% } %></div>
</div></section>
</div>
<% } else if(route==='/contact'){ %>
<div class="page-intro"><h1>取材・協賛のご相談</h1></div><div class="contact-google-layout"><div class="panel"><h2>ご相談内容の例</h2><p>・経営者・社員インタビュー<br>・学生向けイベントの協賛<br>・採用広報や仕事紹介<br>・T-Bizとの共同企画</p><p>返信までの目安：<%= settings.response %></p><p><%= settings.contact %></p></div><%- include('google-form') %></div>
<% } else if(route==='/policy'){ %>
<div class="page-intro"><h1>各種ポリシー</h1></div><nav class="policy-index"><% policies.forEach((p,i)=>{ %><a class="text-link" href="#policy-<%= i %>"><%= p.title %></a><% }); %></nav>
<% policies.forEach((p,i)=>{ %><article class="panel policy-doc" id="policy-<%= i %>"><h2><%= p.title %></h2><p><%= p.intro.replaceAll('【メディア名】',settings.siteName) %></p><% for(const section of p.sections){ %><h3><%= section.title %></h3><% if(section.text){ %><p><%= section.text.replaceAll('【メディア名】',settings.siteName) %></p><% } %><% if(section.items){ %><ul><% for(const item of section.items){ %><li><%= item %></li><% } %></ul><% } %><% if(section.after){ %><p><%= section.after %></p><% } %><% if(section.contact){ %><a class="text-link" href="/contact">お問い合わせフォーム</a><% } %><% } %><p class="date">制定日：<%= settings.policyDate||'未確定' %></p></article><% }); %>
<% } else if(route==='/recruit'){ %><div class="page-intro"><h1>メンバー募集</h1></div><div class="panel"><h2>T-Biz</h2><p><%= settings.org %></p><a class="text-link" href="<%= settings.instagramUrl %>" target="_blank" rel="noopener noreferrer">Instagramで活動を見る</a></div><%- include('google-form') %><% } %>
</section></main><%- include('footer') %></body></html>
