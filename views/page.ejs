<%- include('header') %>
<main class="shell" id="main"><section class="page active<%= route==='/'?' page-home':'' %>">
<% if(route==='/'){ %>
<h1 class="sr-only"><%= settings.siteName %> — 企業インタビューとビジネス知識</h1>
<% if(settings.introCatch||settings.introText||settings.introImageUrl){ %><section class="intro-band intro-split<%= settings.introImageUrl?' has-photo':'' %>" aria-label="このメディアについて"><div class="intro-inner"><div class="intro-copy"><% if(settings.introLabel){ %><p class="intro-label"><%= settings.introLabel %></p><% } %><% if(settings.introCatch){ %><% /* *で囲んだ部分にマーカー。囲みがなければキャッチコピーの最後の行に引く */ const markRe=/[*＊]([^*＊\n]+)[*＊]/g; const marked=(t)=>t.split(markRe); const catchLines=settings.introCatch.split(/\r?\n/); const hasMark=markRe.test(settings.introCatch); markRe.lastIndex=0; %><p class="intro-catch"><% catchLines.forEach((line,li,all)=>{ %><span class="intro-line" style="--i:<%= li %>"><span class="intro-line-in"><% if(hasMark){ marked(line).forEach((part,pi)=>{ %><% if(pi%2){ %><span class="intro-mark"><%= part %></span><% } else { %><%= part %><% } %><% }) } else if(all.length>1&&li===all.length-1){ %><span class="intro-mark"><%= line %></span><% } else { %><%= line %><% } %></span></span><% }) %></p><% } %><div class="intro-body"><% if(settings.introText){ %><p><% (typeof marked==='function'?marked(settings.introText):settings.introText.split(/[*＊]([^*＊\n]+)[*＊]/g)).forEach((part,pi)=>{ %><% if(pi%2){ %><span class="intro-mark"><%= part %></span><% } else { %><%= part %><% } %><% }) %></p><% } %><a class="intro-btn" href="/about">T-Bizとは？<span aria-hidden="true">›</span></a></div></div><% if(settings.introImageUrl){ %><div class="intro-photo"><img src="<%= settings.introImageUrl %>" alt="" fetchpriority="high"></div><% } %></div></section><% } %><% const gallery=settings.gallery||[]; if(gallery.length){ %><section class="gallery-band" aria-label="活動の様子"><div class="gallery-viewport" tabindex="0" aria-label="活動写真（横にスクロールできます）"><div class="gallery-track" style="--n:<%= gallery.length %>"><% for(const copy of [0,1]){ for(const g of gallery){ %><figure class="gallery-item" <%- copy?'aria-hidden="true" data-copy':'' %>><img src="<%= g.url %>" alt="<%= copy?'':g.alt %>" loading="lazy"></figure><% } } %></div></div></section><% } %>

<section class="section pickup-head"><div class="section-head"><h2 class="section-title section-title-en"><span class="en" lang="en">Pick up</span><span class="ja">注目の記事</span></h2></div></section><div class="hero hero-pickup"><div class="hero-art hero-slider" role="region" aria-roledescription="カルーセル" aria-label="注目の記事写真"><div class="slider-stage">
<% if(!data.slides.length){ %><div class="slide-placeholder">写真を準備中です。</div><% } %>
<div class="slider-viewport"><div class="slider-track"><% for(let i=0;i<data.slides.length;i++){ const s=data.slides[i]; const tags=(s.tags||'').split(',').filter(Boolean); const card=Boolean(s.numberLabel||s.dateLabel||s.category||s.author||s.detail||tags.length||s.label); const tag=s.linkUrl?'a':'div'; %><div class="slide <%= card?'is-card':'' %> <%= i===0?'is-active':'' %>" aria-hidden="<%= i!==0 %>"><<%= tag %> class="slide-inner" <% if(s.linkUrl){ %>href="<%= s.linkUrl %>" <%- s.linkUrl.startsWith('https:')?'target="_blank" rel="noopener noreferrer"':'' %><% } %>><% if(card){ %><div class="slide-text"><div class="slide-meta"><div class="slide-no-date"><span class="slide-no"><%= s.numberLabel || String(i+1).padStart(2,'0') %></span><% if(s.dateLabel){ %><span class="slide-date"><%= s.dateLabel %></span><% } %></div><% if(s.category){ %><span class="slide-cat"><%= s.category %></span><% } %></div><% if(s.label){ %><p class="slide-title"><%= s.label %></p><% } %><% if(s.author){ %><p class="slide-person"><%= s.author %></p><% } %><% if(s.detail){ %><p class="slide-detail"><%= s.detail %></p><% } %><% if(tags.length){ %><ul class="slide-tags"><% for(const t of tags){ %><li><%= t %></li><% } %></ul><% } %></div><% } %><div class="slide-img"><img src="<%= s.imageUrl %>" alt="<%= card ? '' : s.label %>" width="1600" height="900" <%- i>0?'loading="lazy"':'' %>><% if(!card && s.label){ %><span><%= s.label %></span><% } %></div></<%= tag %>></div><% } %></div></div>
<% if(data.slides.length>1){ %><button class="slider-control prev" type="button" aria-label="前の写真">‹</button><button class="slider-control next" type="button" aria-label="次の写真">›</button><button class="slider-pause" type="button">一時停止</button><% } %></div>
<% if(data.slides.length>1){ %><div class="slider-dots"><% for(let i=0;i<data.slides.length;i++){ %><button class="slider-dot <%= i===0?'is-active':'' %>" type="button" aria-label="写真<%= i+1 %>を表示" aria-pressed="<%= i===0 %>"></button><% } %></div><% } %></div></div>

<section class="section section-split"><div class="section-head"><h2 class="section-title section-title-en"><span class="en" lang="en">Interview</span><span class="ja">インタビュー</span></h2><a class="link more-link-pc" href="/interviews" lang="en" aria-label="インタビューの記事をもっと見る">see more →</a></div><div class="cards"><%- include('cards',{items:data.interviews}) %></div><a class="more-link-sp" href="/interviews" lang="en" aria-label="インタビューの記事をもっと見る">see more →</a></section>
<% const activityHref='/articles?type='+encodeURIComponent('活動記録'); %><section class="section section-split"><div class="section-head"><h2 class="section-title section-title-en"><span class="en" lang="en">Activity</span><span class="ja">活動記録</span></h2><a class="link more-link-pc" href="<%= activityHref %>" lang="en" aria-label="活動記録の記事をもっと見る">see more →</a></div><div class="cards"><%- include('cards',{items:data.activity}) %></div><a class="more-link-sp" href="<%= activityHref %>" lang="en" aria-label="活動記録の記事をもっと見る">see more →</a></section>
<section class="section section-split"><div class="section-head"><h2 class="section-title section-title-en"><span class="en" lang="en">Knowledge</span><span class="ja">ビジネス知識</span></h2><a class="link more-link-pc" href="/knowledge" lang="en" aria-label="ビジネス知識の記事をもっと見る">see more →</a></div><div class="cards"><%- include('cards',{items:data.knowledge}) %></div><a class="more-link-sp" href="/knowledge" lang="en" aria-label="ビジネス知識の記事をもっと見る">see more →</a></section>

<% } else if(['/articles','/interviews','/knowledge'].includes(route)){ %>
<div class="page-intro"><h1><%= heading %></h1></div><%- include('search') %>
<% } else if(route==='/about'){ %>
<% const nl=(t)=>String(t).split('\n'); const MONTHS=['Jan.','Feb.','Mar.','Apr.','May','Jun.','Jul.','Aug.','Sep.','Oct.','Nov.','Dec.']; const history=[]; for(const raw of String(settings.aboutHistory||'').split(/\r?\n/)){ const line=raw.trim(); if(!line) continue; const m=line.match(/^(\d{4})\s*[.\/\-年]?\s*(?:(\d{1,2})\s*月?)?[\s　:：]+(.+)$/); if(!m){ if(history.length) history[history.length-1].items.at(-1).text+='\n'+line; continue; } const year=m[1]; let g=history.find((h)=>h.year===year); if(!g){ g={year,items:[]}; history.push(g); } g.items.push({month:m[2]?MONTHS[Number(m[2])-1]||'':'',text:m[3]}); } %>
<div class="about-page">
<section class="about-hero<%= settings.aboutImageUrl?' has-photo':'' %>"><div class="about-hero-copy"><p class="about-kicker" lang="en">ABOUT</p><h1 class="about-title"><span lang="en">About Us</span><span class="about-title-ja">私たちについて</span></h1><% if(settings.aboutLead){ %><p class="about-lead"><%= settings.aboutLead %></p><% } %></div><% if(settings.aboutImageUrl){ %><div class="about-hero-photo"><img src="<%= settings.aboutImageUrl %>" alt="" fetchpriority="high"></div><% } %></section>
<% if(settings.introCatch){ %><section class="about-statement"><p class="about-statement-text"><% settings.introCatch.split(/\r?\n/).forEach((line,li,all)=>{ %><%= line.replace(/[*＊]/g,'') %><% if(li<all.length-1){ %><br><% } %><% }) %></p><p class="about-purpose"><%= tbizProfile.purpose %></p></section><% } %>
<section class="about-profile"><h2 class="about-profile-title"><span lang="en">Profile</span><span class="about-sub">団体概要</span></h2>
<div class="about-profile-grid">
<div class="about-outline"><h3 class="about-col-title"><span lang="en">Outline</span><span class="about-sub">団体情報</span></h3><dl class="about-dl"><% for(const [k,v] of tbizProfile.facts){ %><div><dt><%= k %></dt><dd><% nl(v).forEach((line,i,all)=>{ %><%= line %><% if(i<all.length-1){ %><br><% } %><% }) %></dd></div><% } %><div><dt>活動内容</dt><dd><ul class="about-activities"><% for(const act of tbizProfile.activities){ %><li><%= act %></li><% } %></ul></dd></div><div><dt>運営メディア</dt><dd><%= settings.siteName %>（本サイト）<br>企業の経営者・社員へのインタビューや、T-Bizの活動の報告を掲載しています。<% if(settings.noteUrl){ %><br><a class="link" href="<%= settings.noteUrl %>" target="_blank" rel="noopener noreferrer">noteを見る →</a><% } %></dd></div></dl></div>
<div class="about-history"><h3 class="about-col-title"><span lang="en">History</span><span class="about-sub">沿革</span></h3><% if(history.length){ %><ol class="about-timeline"><% for(const g of history){ %><li class="about-year"><p class="about-year-num"><%= g.year %></p><dl class="about-events"><% for(const it of g.items){ %><div><dt lang="en"><%= it.month %></dt><dd><% nl(it.text).forEach((line,i,all)=>{ %><%= line %><% if(i<all.length-1){ %><br><% } %><% }) %></dd></div><% } %></dl></li><% } %></ol><% } else { %><p class="about-empty">準備中です。</p><% } %></div>
</div></section>
</div>
<% } else if(route==='/contact'){ %>
<div class="page-intro"><h1>取材・協賛のご相談</h1></div><div class="contact-google-layout"><div class="panel"><h2>ご相談内容の例</h2><p>・経営者・社員インタビュー<br>・学生向けイベントの協賛<br>・採用広報や仕事紹介<br>・T-Bizとの共同企画</p><p>返信までの目安：<%= settings.response %></p><p><%= settings.contact %></p></div><%- include('google-form') %></div>
<% } else if(route==='/policy'){ %>
<div class="page-intro"><h1>各種ポリシー</h1></div><nav class="policy-index"><% policies.forEach((p,i)=>{ %><a class="text-link" href="#policy-<%= i %>"><%= p.title %></a><% }); %></nav>
<% policies.forEach((p,i)=>{ %><article class="panel policy-doc" id="policy-<%= i %>"><h2><%= p.title %></h2><p><%= p.intro.replaceAll('【メディア名】',settings.siteName) %></p><% for(const section of p.sections){ %><h3><%= section.title %></h3><% if(section.text){ %><p><%= section.text.replaceAll('【メディア名】',settings.siteName) %></p><% } %><% if(section.items){ %><ul><% for(const item of section.items){ %><li><%= item %></li><% } %></ul><% } %><% if(section.after){ %><p><%= section.after %></p><% } %><% if(section.contact){ %><a class="text-link" href="/contact">お問い合わせフォーム</a><% } %><% } %><p class="date">制定日：<%= settings.policyDate||'未確定' %></p></article><% }); %>
<% } else if(route==='/shinkan'){ %><div class="page-intro"><h1>新歓特設ページ</h1></div><div class="panel empty-state">準備中です。公開まで少々お待ちください。</div><% } else if(route==='/recruit'){ %><div class="page-intro"><h1>メンバー募集</h1></div><div class="panel"><h2>T-Biz</h2><p><%= settings.org %></p><a class="text-link" href="<%= settings.instagramUrl %>" target="_blank" rel="noopener noreferrer">Instagramで活動を見る</a></div><%- include('google-form') %><% } %>
</section></main><%- include('footer') %></body></html>
