<form class="filters search-form" action="<%= route %>" method="get" data-category="<%= route==='/interviews'?'interviews':route==='/knowledge'?'knowledge':'' %>"><label class="search-query">キーワード<input type="search" name="q" value="<%= query.q||'' %>" maxlength="240" placeholder="タイトル・冒頭文を検索"></label><label>業界<select name="industry"><option value="">すべて</option><% for(const i of industries){ %><option <%- query.industry===i?'selected':'' %>><%= i %></option><% } %></select></label><label>企業規模<select name="size"><option value="">すべて</option><% for(const i of sizes){ %><option <%- query.size===i?'selected':'' %>><%= i %></option><% } %></select></label><label>記事タイプ<select name="type"><option value="">すべて</option><% for(const i of (route==='/interviews'?types.slice(0,3):route==='/knowledge'?['ビジネス知識']:types)){ %><option <%- query.type===i?'selected':'' %>><%= i %></option><% } %></select></label><label>並べ替え<select name="sort"><option value="new" <%- query.sort!=='old'?'selected':'' %>>新しい順</option><option value="old" <%- query.sort==='old'?'selected':'' %>>古い順</option></select></label><label class="search-exact"><input type="checkbox" name="exact" value="true" <%- query.exact==='true'?'checked':'' %>>完全一致</label><button class="btn" type="submit">検索</button></form>
<div class="results-line"><span id="resultCount" role="status"><%= listing.total %>件の記事</span><span>note記事へリンクします</span></div><div class="article-grid" id="searchGrid"><%- include('cards',{items:listing.items,filtered:['q','industry','size','type'].some(k=>query[k])}) %></div>
<nav class="pagination" aria-label="検索結果のページ"><% if(listing.page>1){ %><a href="?<%= new URLSearchParams({...query,page:listing.page-1}).toString() %>">前のページ</a><% } %><span><%= listing.page %> / <%= listing.pages %></span><% if(listing.page<listing.pages){ %><a href="?<%= new URLSearchParams({...query,page:listing.page+1}).toString() %>">次のページ</a><% } %></nav>
