<% const fixedTypes=route==='/interviews'?['インタビュー']:route==='/knowledge'?['ビジネス知識']:null; const legacy={'経営者インタビュー':'インタビュー','若手社員インタビュー':'インタビュー','座談会':'活動記録'}; const curType=fixedTypes?fixedTypes[0]:(legacy[query.type]||query.type||''); %><form class="filters search-form" action="<%= route %>" method="get" data-category="<%= route==='/interviews'?'interviews':route==='/knowledge'?'knowledge':'' %>" data-type="<%= curType %>"><label class="search-type">記事タイプ<select name="type" data-type-select><% if(!fixedTypes){ %><option value="">すべて</option><% } %><% for(const i of (fixedTypes||types)){ %><option <%- curType===i?'selected':'' %>><%= i %></option><% } %></select></label><label class="search-query">キーワード<input type="search" name="q" value="<%= query.q||'' %>" maxlength="240" placeholder="タイトル・冒頭文を検索"></label><label class="search-dep" data-for-type="インタビュー" <%- curType==='インタビュー'?'':'hidden' %>>業界<select name="industry" <%- curType==='インタビュー'?'':'disabled' %>><option value="">すべて</option><% for(const i of industries){ %><option <%- query.industry===i?'selected':'' %>><%= i %></option><% } %></select></label><label class="search-dep" data-for-type="活動記録" <%- curType==='活動記録'?'':'hidden' %>>コンテンツ<select name="activityKind" <%- curType==='活動記録'?'':'disabled' %>><option value="">すべて</option><% for(const i of activityKinds){ %><option <%- query.activityKind===i?'selected':'' %>><%= i %></option><% } %></select></label><label class="search-sort">並べ替え<select name="sort"><option value="new" <%- query.sort!=='old'?'selected':'' %>>新しい順</option><option value="old" <%- query.sort==='old'?'selected':'' %>>古い順</option></select></label><label class="search-exact"><input type="checkbox" name="exact" value="true" <%- query.exact==='true'?'checked':'' %>>完全一致</label><button class="ab" type="submit">検索<%- include('arrow') %></button></form>
<div class="results-line"><span id="resultCount" role="status"><%= listing.total %>件の記事</span><span>note記事へリンクします</span></div><div class="article-grid" id="searchGrid"><%- include('cards',{items:listing.items,filtered:['q','industry','activityKind','type'].some(k=>query[k])}) %></div>
<nav class="pagination" aria-label="検索結果のページ"><% if(listing.page>1){ %><a href="?<%= new URLSearchParams({...query,page:listing.page-1}).toString() %>">前のページ</a><% } %><span><%= listing.page %> / <%= listing.pages %></span><% if(listing.page<listing.pages){ %><a href="?<%= new URLSearchParams({...query,page:listing.page+1}).toString() %>">次のページ</a><% } %></nav>
