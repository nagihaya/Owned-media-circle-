<!doctype html>
<html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %></title><meta name="description" content="T-Bizの新歓特設ページ。公開準備中です。"><meta property="og:title" content="<%= title %>"><meta property="og:site_name" content="<%= settings.siteName %>"><meta property="og:type" content="website"><% if(canonical){ %><link rel="canonical" href="<%= canonical %>"><meta property="og:url" content="<%= canonical %>"><% } %><link rel="icon" href="<%= settings.logoUrl %>"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&display=swap"><link rel="stylesheet" href="/shinkan.css"><script src="/shinkan.js" defer></script></head>
<body class="sk">
<main class="sk-main" id="main">
  <div class="sk-bg" aria-hidden="true"><% [["circle","#e5484d",56,"8%","18%"],["square","#2f5bd8",44,"86%","14%"],["triangle","#f2b705",60,"78%","72%"],["ring","#12a26b",50,"6%","66%"],["blob","#ff7a1a",64,"92%","46%"],["circle","#2f5bd8",22,"56%","10%"],["square","#12a26b",26,"52%","96%"],["pill","#8e5bd8",58,"64%","90%"]].forEach(([k,c,sz,x,y],i)=>{ %><span class="sk-shape is-<%= k %>" style="--c:<%= c %>;--s:<%= sz %>px;left:<%= x %>;top:<%= y %>;--i:<%= i %>"></span><% }) %></div>
  <section class="sk-hero">
    <p class="sk-kicker"><img src="<%= settings.logoUrl %>" alt="" width="36" height="36"><span><%= settings.siteName %></span><span class="sk-dot" aria-hidden="true"></span><span>新歓特設ページ</span></p>
    <h1 class="sk-title" lang="en"><span class="sk-line" style="--i:0">Welcome</span><span class="sk-line" style="--i:1">to <span class="sk-hand-mark"><%= settings.siteName %><svg class="sk-scribble" viewBox="0 0 300 40" preserveAspectRatio="none" aria-hidden="true"><path d="M4 26 C 60 12, 120 34, 180 20 S 270 14, 296 24" /><path d="M14 34 C 80 24, 160 38, 286 30" /></svg></span>.</span></h1>
    <p class="sk-catch">やりたいを、形にする仲間へ。</p>
    <p class="sk-soon" lang="en">Coming Soon<svg class="sk-circle" viewBox="0 0 220 70" preserveAspectRatio="none" aria-hidden="true"><path d="M30 12 C 90 -4, 200 4, 212 32 C 222 60, 120 70, 50 62 C 0 56, 2 24, 40 12 C 70 4, 110 4, 140 8" /></svg></p>
    <p class="sk-text">新歓特設ページは、ただいま公開の準備中です。<br>説明会の日程や活動の紹介を、ここでお知らせします。</p>
    <div class="sk-actions">
      <% if(settings.instagramUrl){ %><a class="sk-btn" href="<%= settings.instagramUrl %>" target="_blank" rel="noopener noreferrer">Instagramで最新情報を見る<%- include('arrow') %><span class="sk-sr">（新しいタブで開く）</span></a><% } %>
      <a class="sk-link" href="/">T-Bizのサイトへ<%- include('arrow') %></a>
    </div>
  </section>
  <a class="sk-scroll" href="#sk-next" aria-label="下へスクロール"><span class="sk-scroll-word" lang="en">scroll<svg class="sk-scroll-ring" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="48" pathLength="100" /></svg></span><svg class="sk-scroll-arrow" viewBox="0 0 40 70" aria-hidden="true"><path d="M20 4 V64" /><path d="M8 52 L20 65 L32 52" /></svg></a>
</main>
<div id="sk-next" class="sk-next" aria-hidden="true"></div>
<% const skMembers=settings.shinkanMembers||[]; if(skMembers.length){ %><section class="skm" aria-labelledby="skm-title"><div class="skm-head"><h2 id="skm-title"><span lang="en">Keyword</span></h2></div>
<% const tagCount=new Map(); for(const m of skMembers) for(const t of m.tags) tagCount.set(t,(tagCount.get(t)||0)+1); const allTags=[...tagCount.entries()].sort((a,b)=>b[1]-a[1]).map(([t])=>t); %><% if(allTags.length){ %><div class="skm-filter" role="group" aria-label="タグで絞り込む"><button type="button" class="skm-chip" data-tag="" aria-pressed="true">#すべて</button><% for(const t of allTags){ %><button type="button" class="skm-chip" data-tag="<%= t %>" aria-pressed="false">#<%= t %></button><% } %><p class="skm-count" role="status"><span data-count><%= skMembers.length %></span>人</p></div><% } %>
<ul class="skm-grid"><% skMembers.forEach((m,i)=>{ %><li class="skm-card skm-bg<%= i%9 %><%= m.qa&&m.qa.length?' has-qa':'' %>" data-tags="<%= JSON.stringify(m.tags) %>"><% if(m.qa&&m.qa.length){ %><button class="skm-flip" type="button" aria-pressed="false" aria-label="カードを裏返してQ&Aを見る"><span class="skm-inner"><span class="skm-face skm-front"><% } else { %><div class="skm-inner"><div class="skm-face skm-front"><% } %><span class="skm-visual"><span class="skm-shape is-circle"><% if(m.url){ %><img src="<%= m.url %>" alt="" loading="lazy"><% } else { %><span class="skm-noimg" aria-hidden="true"></span><% } %></span><% if(m.bubble){ %><span class="skm-bubble skm-bb<%= i%5 %> <%= i%2?'is-bottom':'is-top' %>"><span class="sk-sr">入った理由：</span><%= m.bubble %></span><% } %></span><% if(m.tags.length){ %><span class="skm-tags"><% for(const t of m.tags){ %><span class="skm-tag">#<%= t %></span><% } %></span><% } %><% if(m.qa&&m.qa.length){ %><span class="skm-hint" lang="en" aria-hidden="true">Q&amp;A ↻</span></span><span class="skm-face skm-back"><span class="skm-back-title" lang="en">Q&amp;A</span><span class="skm-qa"><% for(const x of m.qa){ %><span class="skm-q"><b lang="en">Q.</b><%= x.q %></span><span class="skm-a"><b lang="en">A.</b><%= x.a %></span><% } %></span><span class="skm-hint" aria-hidden="true">タップで戻る ↻</span></span></span></button><% } else { %></div></div><% } %></li><% }) %></ul></section><% } %>
<% /* よくある質問：「Q.」の行が質問、「A.」の行から回答（複数行可）。回答のない質問は出さない */ const skFaq=[]; for(const raw of String(settings.shinkanFaq||'').split(/\r?\n/)){ const l=raw.trim(); const mq=l.match(/^[QＱ][.．:：]?\s*(.*)$/); const ma=l.match(/^[AＡ][.．:：]?\s*(.*)$/); if(mq){ skFaq.push({q:mq[1],a:[]}); } else if(ma&&skFaq.length){ skFaq[skFaq.length-1].a.push(ma[1]); } else if(skFaq.length&&skFaq[skFaq.length-1].a.length){ skFaq[skFaq.length-1].a.push(l); } } const skFaqItems=skFaq.map((f)=>({q:f.q.trim(),a:f.a.join('\n').trim()})).filter((f)=>f.q&&f.a); %>
<% if(skFaqItems.length){ %><section class="skq" aria-labelledby="skq-title"><div class="skv-head"><h2 id="skq-title"><span lang="en">FAQ</span><span class="skv-sub">よくある質問</span></h2></div>
<div class="skq-list"><% skFaqItems.forEach((f,i)=>{ %><details class="skq-item"><summary><span class="skq-mark skq-q" aria-hidden="true">Q</span><span class="skq-question"><%= f.q %></span><span class="skq-icon" aria-hidden="true"></span></summary><div class="skq-answer"><span class="skq-mark skq-a" aria-hidden="true">A</span><div class="skq-text"><% f.a.split(/\n/).forEach((p)=>{ if(p.trim()){ %><p><%= p %></p><% } }) %></div></div></details><% }) %></div>
<script type="application/ld+json"><%- JSON.stringify({"@context":"https://schema.org","@type":"FAQPage","mainEntity":skFaqItems.map((f)=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}}))}).replace(/</g,'\\u003c') %></script></section><% } %>
<% const skYear=new Date().toLocaleString("ja-JP",{timeZone:"Asia/Tokyo",year:"numeric"}).replace(/\D/g,""); const skExt=(u)=>/^https:/.test(u||""); const skCols=[["About",[["T-Bizとは？","/about"],["活動記録","/articles?type="+encodeURIComponent("活動記録")],["インタビュー","/interviews"],["ビジネス知識","/knowledge"]]],["Join",[["メンバー募集","/recruit"],["お問い合わせ","/contact"]]],["Related",[["T-Biz（メディア）","/"],settings.noteUrl?["note",settings.noteUrl]:null,settings.instagramUrl?["Instagram",settings.instagramUrl]:null].filter(Boolean)]]; %>
<footer class="skf" aria-label="新歓特設ページの案内">
  <div class="skf-inner">
    <div class="skf-brand">
      <a class="skf-logo" href="/"><img src="<%= settings.logoUrl %>" alt="" width="40" height="40" loading="lazy"><span><span lang="en"><%= settings.siteName %></span> <span class="skf-logo-sub">新歓</span></span></a>
      <div class="skf-social">
        <% if(settings.xUrl){ %><a href="<%= settings.xUrl %>" target="_blank" rel="noopener noreferrer" aria-label="X（新しいタブで開く）"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a><% } %>
        <% if(settings.instagramUrl){ %><a href="<%= settings.instagramUrl %>" target="_blank" rel="noopener noreferrer" aria-label="Instagram（新しいタブで開く）"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg></a><% } %>
        <% if(settings.noteUrl){ %><a class="skf-note" href="<%= settings.noteUrl %>" target="_blank" rel="noopener noreferrer" aria-label="note（新しいタブで開く）">note</a><% } %>
      </div>
    </div>
    <nav class="skf-cols" aria-label="リンク">
      <% for(const [title,links] of skCols){ %><div class="skf-col"><h2 lang="en"><%= title %></h2><ul><% for(const [label,href] of links){ %><li><a href="<%= href %>" <%- skExt(href)?'target="_blank" rel="noopener noreferrer"':'' %>><%= label %><% if(skExt(href)){ %><svg class="skf-ext" viewBox="0 0 16 16" aria-hidden="true"><path d="M9 2h5v5M14 2 7 9M12 9.5V13a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3.5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg><span class="sk-sr">（新しいタブで開く）</span><% } %></a></li><% } %></ul></div><% } %>
    </nav>
    <div class="skf-banners">
      <a class="skf-banner skf-banner-media" href="/"><span class="skf-banner-title" lang="en"><%= settings.siteName %></span><span class="skf-banner-sub">企業インタビュー・活動記録を読む</span></a>
      <% if(settings.instagramUrl){ %><a class="skf-banner skf-banner-ig" href="<%= settings.instagramUrl %>" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg><span class="skf-banner-sub">Instagramでも<br>新歓情報を更新中</span><span class="sk-sr">（新しいタブで開く）</span></a><% } %>
    </div>
  </div>
  <div class="skf-bottom"><a href="/policy#policy-0">プライバシーポリシー</a><p>© <%= skYear %> <%= settings.siteName %></p></div>
</footer>
</body></html>
